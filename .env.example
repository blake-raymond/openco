# Private data repository. Relative paths are resolved from the openco
# checkout, not from the shell's current directory.
# OPENCO_DATA_REPO=../openco-data

# Second brain. notion is the default. markdown uses the me/ folder only.
# Put the real token and database id in .env, which is gitignored.
# SECOND_BRAIN=notion
# NOTION_TOKEN=
# NOTION_SECOND_BRAIN_DB=

# MCP secrets. Keep them here, not in config/mcp.example.json.
# GITHUB_TOKEN=
# SLACK_TOKEN=
# LINEAR_API_KEY=
# STRIPE_SECRET_KEY=
# POSTHOG_API_KEY=
# SUPABASE_ACCESS_TOKEN=
